<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup before Android 12 (GDD 16 rule 18): the profile (chronicle, best scores,
     settings) is backed up, the match in progress is not. With an <include>, whatever is not
     listed stays out; the files of the profile are profile.sav and its copy profile.bak
     (ADR-0006). user:// is the internal files directory or the external one: both are listed. -->
<full-backup-content>
    <include domain="file" path="profile.sav"/>
    <include domain="file" path="profile.bak"/>
    <include domain="external" path="profile.sav"/>
    <include domain="external" path="profile.bak"/>
</full-backup-content>
